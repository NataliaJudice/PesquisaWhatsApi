@{
    ViewData["Title"] = "Simulador";
    var fluxos = ViewBag.Fluxos as List<PesquisaWhatsApi.Models.Fluxos> ?? new List<PesquisaWhatsApi.Models.Fluxos>();
    var selecionado = ViewBag.FluxoSelecionado as int?;
}

<div class="max-w-6xl mx-auto">

    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-white">Simulador de conversa</h1>
        <p class="text-sm text-gray-500 mt-1">Teste o fluxo aqui antes de publicar no WhatsApp — o motor é exatamente o mesmo.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-6 items-start">

        <!-- Configuração do teste -->
        <div class="bg-[#11141a] border border-white/5 rounded-2xl p-5 space-y-4">
            <div class="flex items-center gap-2 text-gray-300">
                <i data-lucide="sliders-horizontal" class="w-4 h-4 text-emerald-400"></i>
                <h2 class="text-sm font-semibold">Configuração</h2>
            </div>

            <div>
                <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600 block mb-1.5">Fluxo a testar</label>
                <select id="ddlFluxo" class="w-full bg-[#161a22] border border-white/10 rounded-lg px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-emerald-500/50">
                    @if (!fluxos.Any())
                    {
                        <option value="">Nenhum fluxo ativo</option>
                    }
                    @foreach (var fluxo in fluxos)
                    {
                        <option value="@fluxo.Id" selected="@(selecionado == fluxo.Id)">@fluxo.Nome @(fluxo.EhPadrao ? "(padrão)" : "")</option>
                    }
                </select>
            </div>

            <div>
                <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600 block mb-1.5">Número do cliente fictício</label>
                <input type="text" id="txtTelefone" value="5524999999999"
                       class="w-full bg-[#161a22] border border-white/10 rounded-lg px-3 py-2 text-sm text-gray-200 focus:outline-none focus:border-emerald-500/50" />
                <p class="text-[10px] text-gray-600 mt-1.5">A conversa do simulador é separada da conversa real do WhatsApp.</p>
            </div>

            <button type="button" id="btnIniciar"
                    class="w-full inline-flex items-center justify-center gap-2 bg-emerald-500 hover:bg-emerald-400 text-[#0d0f13] font-semibold text-sm px-4 py-2.5 rounded-lg transition">
                <i data-lucide="rotate-ccw" class="w-4 h-4"></i> Iniciar / reiniciar conversa
            </button>

            <div class="border-t border-white/5 pt-4 space-y-2 text-[11px] text-gray-500 leading-relaxed">
                <p class="text-[10px] font-bold uppercase tracking-widest text-gray-600">Comandos que sempre funcionam</p>
                <p><span class="text-gray-300 font-mono">menu</span> volta ao início do fluxo</p>
                <p><span class="text-gray-300 font-mono">sair</span> encerra o atendimento</p>
            </div>

            <div id="painelProtocolo" class="hidden border-t border-white/5 pt-4 text-[11px] text-gray-500">
                <p>Protocolo: <span id="lblProtocolo" class="text-gray-300 font-mono"></span></p>
                <p>Passo atual: <span id="lblNo" class="text-gray-300 font-mono"></span></p>
            </div>
        </div>

        <!-- Telefone -->
        <div class="bg-[#11141a] border border-white/5 rounded-2xl overflow-hidden flex flex-col" style="height: 74vh; min-height: 520px;">
            <div class="h-16 shrink-0 px-4 flex items-center gap-3 bg-[#1f2c33] border-b border-black/20">
                <span class="w-10 h-10 rounded-full bg-emerald-500/20 text-emerald-300 flex items-center justify-center">
                    <i data-lucide="bot" class="w-5 h-5"></i>
                </span>
                <div class="min-w-0">
                    <p class="text-sm font-medium text-gray-100 truncate">Bot de atendimento</p>
                    <p class="text-[11px] text-gray-400" id="lblStatus">aguardando início</p>
                </div>
            </div>

            <div id="chat" class="flex-1 overflow-y-auto p-5 space-y-3 chat-wallpaper">
                <div class="text-center py-10" id="chatVazio">
                    <span class="inline-flex w-12 h-12 rounded-2xl bg-white/5 text-gray-600 items-center justify-center mb-3">
                        <i data-lucide="message-circle" class="w-5 h-5"></i>
                    </span>
                    <p class="text-xs text-gray-500">Clique em "Iniciar conversa" para ver o bot em ação.</p>
                </div>
            </div>

            <div id="quickReplies" class="shrink-0 px-4 pt-3 flex flex-wrap gap-2 empty:hidden bg-[#11141a]"></div>

            <div class="shrink-0 p-3 bg-[#11141a] border-t border-white/5 flex items-center gap-2">
                <input type="text" id="txtMensagem" disabled placeholder="Digite como se fosse o cliente..."
                       class="flex-1 bg-[#161a22] border border-white/10 rounded-full px-4 py-2.5 text-sm text-gray-200 placeholder-gray-600 focus:outline-none focus:border-emerald-500/50 disabled:opacity-50" />
                <button type="button" id="btnEnviar" disabled
                        class="w-11 h-11 shrink-0 rounded-full bg-emerald-500 hover:bg-emerald-400 disabled:opacity-40 disabled:hover:bg-emerald-500 text-[#0d0f13] flex items-center justify-center transition">
                    <i data-lucide="send" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            "use strict";

            const chat = document.getElementById("chat");
            const chatVazio = document.getElementById("chatVazio");
            const quickReplies = document.getElementById("quickReplies");
            const txtMensagem = document.getElementById("txtMensagem");
            const btnEnviar = document.getElementById("btnEnviar");
            const lblStatus = document.getElementById("lblStatus");

            function escapar(texto) {
                const div = document.createElement("div");
                div.textContent = texto || "";
                return div.innerHTML;
            }

            // Aplica a formatação do WhatsApp (*negrito*, _itálico_) e quebras de linha
            function formatar(texto) {
                return escapar(texto)
                    .replace(/\*([^*\n]+)\*/g, "<strong>$1</strong>")
                    .replace(/_([^_\n]+)_/g, "<em>$1</em>")
                    .replace(/\n/g, "<br />");
            }

            function hora() {
                return new Date().toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
            }

            function rolar() {
                chat.scrollTop = chat.scrollHeight;
            }

            function balao(texto, tipo) {
                if (chatVazio) chatVazio.remove();

                const linha = document.createElement("div");

                if (tipo === "sistema") {
                    linha.className = "flex justify-center";
                    linha.innerHTML =
                        '<div class="bg-amber-500/10 border border-amber-500/20 text-amber-200 text-[11px] px-3 py-1.5 rounded-lg max-w-[80%] text-center">' +
                        formatar(texto) + "</div>";
                } else if (tipo === "usuario") {
                    linha.className = "flex justify-end";
                    linha.innerHTML =
                        '<div class="balao-usuario bg-[#005c4b] text-gray-50 text-sm px-3.5 py-2 max-w-[75%] shadow">' +
                        '<div class="leading-relaxed break-words">' + formatar(texto) + "</div>" +
                        '<div class="text-[10px] text-emerald-200/60 text-right mt-1">' + hora() + "</div></div>";
                } else {
                    linha.className = "flex justify-start";
                    linha.innerHTML =
                        '<div class="balao-bot bg-[#202c33] text-gray-100 text-sm px-3.5 py-2 max-w-[75%] shadow">' +
                        '<div class="leading-relaxed break-words">' + formatar(texto) + "</div>" +
                        '<div class="text-[10px] text-gray-500 text-right mt-1">' + hora() + "</div></div>";
                }

                chat.appendChild(linha);
                rolar();
            }

            function digitando(ligado) {
                const existente = document.getElementById("digitando");
                if (existente) existente.remove();
                if (!ligado) return;

                const linha = document.createElement("div");
                linha.id = "digitando";
                linha.className = "flex justify-start";
                linha.innerHTML = '<div class="balao-bot bg-[#202c33] px-4 py-3 digitando"><span></span><span></span><span></span></div>';
                chat.appendChild(linha);
                rolar();
            }

            // Exibe as mensagens do bot com um pequeno intervalo, como no WhatsApp real
            async function exibirRespostas(mensagens) {
                for (const mensagem of mensagens) {
                    digitando(true);
                    await new Promise(r => setTimeout(r, Math.min(700, 220 + mensagem.length * 8)));
                    digitando(false);
                    balao(mensagem, "bot");
                }
            }

            function mostrarOpcoes(opcoes) {
                quickReplies.innerHTML = "";
                (opcoes || []).forEach(opcao => {
                    const botao = document.createElement("button");
                    botao.type = "button";
                    botao.className =
                        "text-xs px-3 py-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition";
                    botao.textContent = opcao;
                    botao.addEventListener("click", () => enviar(opcao));
                    quickReplies.appendChild(botao);
                });
            }

            function atualizarPainel(resposta) {
                if (resposta.protocolo) {
                    document.getElementById("painelProtocolo").classList.remove("hidden");
                    document.getElementById("lblProtocolo").textContent = resposta.protocolo;
                }
                document.getElementById("lblNo").textContent = resposta.noId ? "#" + resposta.noId : "—";

                if (resposta.finalizado) {
                    lblStatus.textContent = "conversa finalizada";
                    mostrarOpcoes([]);
                } else {
                    lblStatus.textContent = "online";
                }
            }

            function habilitar(ligado) {
                txtMensagem.disabled = !ligado;
                btnEnviar.disabled = !ligado;
            }

            document.getElementById("btnIniciar").addEventListener("click", async function () {
                const fluxoId = document.getElementById("ddlFluxo").value;
                const telefone = document.getElementById("txtTelefone").value.trim();

                if (!fluxoId) {
                    App.toast("Crie e ative um fluxo antes de testar.", "erro");
                    return;
                }
                if (!telefone) {
                    App.toast("Informe um número para o cliente fictício.", "erro");
                    return;
                }

                chat.innerHTML = "";
                mostrarOpcoes([]);

                try {
                    const resposta = await App.postForm("/Simulador/IniciarSimulacao", { telefone, fluxoId });

                    if (!resposta.sucesso) {
                        balao(resposta.mensagens[0] || "Não foi possível iniciar.", "sistema");
                        return;
                    }

                    habilitar(true);
                    await exibirRespostas(resposta.mensagens);
                    mostrarOpcoes(resposta.opcoes);
                    atualizarPainel(resposta);
                    txtMensagem.focus();
                } catch (erro) {
                    console.error(erro);
                    App.toast("Erro ao falar com o servidor.", "erro");
                }
            });

            async function enviar(textoForcado) {
                const telefone = document.getElementById("txtTelefone").value.trim();
                const texto = (textoForcado !== undefined ? textoForcado : txtMensagem.value).trim();
                if (!texto) return;

                balao(texto, "usuario");
                txtMensagem.value = "";
                mostrarOpcoes([]);

                try {
                    const resposta = await App.postForm("/Simulador/EnviarMensagem", { telefone, texto });

                    if (resposta.entradaInvalida) {
                        await exibirRespostas(resposta.mensagens);
                        mostrarOpcoes(resposta.opcoes);
                        return;
                    }

                    if (!resposta.sucesso) {
                        balao(resposta.mensagens[0] || "Algo deu errado.", "sistema");
                        return;
                    }

                    await exibirRespostas(resposta.mensagens);
                    mostrarOpcoes(resposta.opcoes);
                    atualizarPainel(resposta);
                } catch (erro) {
                    console.error(erro);
                    App.toast("Erro ao falar com o servidor.", "erro");
                }
            }

            btnEnviar.addEventListener("click", () => enviar());
            txtMensagem.addEventListener("keydown", e => { if (e.key === "Enter") enviar(); });
        })();
    </script>
}
