@{
    var rota = ViewContext.RouteData.Values;
    var controller = (rota["controller"] as string) ?? string.Empty;

    string LinkClasse(string alvo) => string.Equals(controller, alvo, StringComparison.OrdinalIgnoreCase)
        ? "flex items-center gap-3 px-3 py-2 rounded-lg bg-emerald-500/10 text-emerald-300 border border-emerald-500/20 text-sm font-medium transition"
        : "flex items-center gap-3 px-3 py-2 rounded-lg text-gray-400 hover:text-gray-100 hover:bg-white/5 border border-transparent text-sm font-medium transition";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Chatbot WhatsApp</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="bg-[#0d0f13] text-gray-200 min-h-screen antialiased">
    @Html.AntiForgeryToken()

    <div class="flex min-h-screen">
        <aside class="w-60 shrink-0 border-r border-white/5 bg-[#11141a] flex flex-col">
            <a asp-controller="Fluxo" asp-action="Index" class="h-16 px-5 flex items-center gap-3 border-b border-white/5">
                <span class="w-9 h-9 rounded-xl bg-emerald-500 flex items-center justify-center text-[#0d0f13]">
                    <i data-lucide="message-circle-more" class="w-5 h-5"></i>
                </span>
                <span class="leading-tight">
                    <span class="block text-sm font-semibold text-white">Chatbot Studio</span>
                    <span class="block text-[11px] text-gray-500">WhatsApp Business</span>
                </span>
            </a>

            <nav class="p-3 space-y-1 flex-1">
                <p class="px-3 pt-2 pb-1 text-[10px] font-bold uppercase tracking-widest text-gray-600">Construir</p>
                <a asp-controller="Fluxo" asp-action="Index" class="@LinkClasse("Fluxo")">
                    <i data-lucide="workflow" class="w-4 h-4"></i> Meus fluxos
                </a>
                <a asp-controller="Simulador" asp-action="Index" class="@LinkClasse("Simulador")">
                    <i data-lucide="play-circle" class="w-4 h-4"></i> Simulador
                </a>

                <p class="px-3 pt-4 pb-1 text-[10px] font-bold uppercase tracking-widest text-gray-600">Publicar</p>
                <a asp-controller="WhatsApp" asp-action="Index" class="@LinkClasse("WhatsApp")">
                    <i data-lucide="smartphone" class="w-4 h-4"></i> WhatsApp
                </a>
            </nav>

            <div class="p-3 border-t border-white/5">
                <div class="rounded-xl bg-[#161a22] border border-white/5 p-3">
                    <p class="text-[11px] text-gray-500 leading-relaxed">
                        Monte o fluxo, teste no simulador e publique no WhatsApp.
                    </p>
                </div>
            </div>
        </aside>

        <div class="flex-1 min-w-0 flex flex-col">
            <main class="flex-1 p-8">
                @RenderBody()
            </main>
        </div>
    </div>

    <div id="toasts" class="fixed bottom-6 right-6 z-50 space-y-2"></div>

    @if (TempData["Sucesso"] != null)
    {
        <script>window.__toastInicial = { tipo: 'sucesso', texto: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Sucesso"]?.ToString())) };</script>
    }
    @if (TempData["Erro"] != null)
    {
        <script>window.__toastInicial = { tipo: 'erro', texto: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Erro"]?.ToString())) };</script>
    }

    <script src="~/js/app.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
