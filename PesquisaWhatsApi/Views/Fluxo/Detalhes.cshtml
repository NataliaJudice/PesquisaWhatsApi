@model PesquisaWhatsApi.Models.ViewModels.FluxoBuilderViewModel
@{
    Layout = null;
    var fluxoJson = System.Text.Json.JsonSerializer.Serialize(Model, new System.Text.Json.JsonSerializerOptions
    {
        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
    });
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Model.Nome · Construtor</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body class="bg-[#0d0f13] text-gray-200 h-screen flex flex-col overflow-hidden antialiased">
    @Html.AntiForgeryToken()

    <!-- ======================= TOPO ======================= -->
    <header class="h-14 shrink-0 border-b border-white/5 bg-[#11141a] px-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3 min-w-0">
            <a asp-action="Index" class="w-8 h-8 rounded-lg border border-white/10 hover:bg-white/5 flex items-center justify-center text-gray-400 transition" title="Voltar para a lista">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
            </a>
            <span class="w-8 h-8 rounded-lg bg-emerald-500 text-[#0d0f13] flex items-center justify-center shrink-0">
                <i data-lucide="git-branch" class="w-4 h-4"></i>
            </span>
            <div class="min-w-0">
                <input id="nomeFluxo" value="@Model.Nome" maxlength="80"
                       class="bg-transparent text-sm font-semibold text-white w-full max-w-xs truncate border border-transparent hover:border-white/10 focus:border-emerald-500/50 rounded px-2 py-0.5 focus:outline-none transition" />
                <div class="px-2 flex items-center gap-2 text-[11px] text-gray-500">
                    <span id="contadorPassos">@Model.Nos.Count passos</span>
                    <span>·</span>
                    <span id="statusSalvo" class="text-gray-600">tudo salvo</span>
                </div>
            </div>
        </div>

        <div class="flex items-center gap-2 shrink-0">
            @if (Model.EhPadrao)
            {
                <span class="hidden md:inline-flex items-center gap-1.5 text-[10px] font-bold uppercase tracking-wider px-2.5 py-1.5 rounded-md bg-emerald-500/15 text-emerald-300 border border-emerald-500/20">
                    <i data-lucide="smartphone" class="w-3 h-3"></i> Publicado no WhatsApp
                </span>
            }
            else
            {
                <form asp-action="DefinirPadrao" method="post" class="hidden md:inline">
                    <input type="hidden" name="fluxoId" value="@Model.Id" />
                    <button type="submit" class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md border border-white/10 hover:bg-white/5 text-gray-300 transition">
                        <i data-lucide="smartphone" class="w-3.5 h-3.5"></i> Publicar no WhatsApp
                    </button>
                </form>
            }

            <button type="button" id="btnOrganizar" class="inline-flex items-center gap-1.5 text-xs px-3 py-1.5 rounded-md border border-white/10 hover:bg-white/5 text-gray-300 transition" title="Reorganizar os blocos automaticamente">
                <i data-lucide="layout-grid" class="w-3.5 h-3.5"></i> Organizar
            </button>

            <a asp-controller="Simulador" asp-action="Index" asp-route-fluxoId="@Model.Id" target="_blank"
               class="inline-flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-md bg-emerald-500 hover:bg-emerald-400 text-[#0d0f13] transition">
                <i data-lucide="play" class="w-3.5 h-3.5"></i> Testar bot
            </a>
        </div>
    </header>

    <div class="flex flex-1 min-h-0">

        <!-- ======================= PALETA ======================= -->
        <aside class="w-56 shrink-0 border-r border-white/5 bg-[#11141a] p-3 flex flex-col gap-4 overflow-y-auto">
            <div>
                <p class="text-[10px] font-bold uppercase tracking-widest text-gray-600 px-1 mb-2">Adicionar bloco</p>
                <div class="space-y-2">
                    <button type="button" data-novo="mensagem" class="w-full text-left flex items-center gap-3 p-2.5 bg-[#161a22] hover:bg-[#1b202a] border border-white/5 hover:border-white/10 rounded-xl transition">
                        <span class="w-8 h-8 rounded-lg bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
                            <i data-lucide="message-square" class="w-4 h-4"></i>
                        </span>
                        <span class="min-w-0">
                            <span class="text-xs font-medium block text-gray-200">Mensagem</span>
                            <span class="text-[10px] text-gray-500 block">Só envia um texto</span>
                        </span>
                    </button>

                    <button type="button" data-novo="menu" class="w-full text-left flex items-center gap-3 p-2.5 bg-[#161a22] hover:bg-[#1b202a] border border-white/5 hover:border-white/10 rounded-xl transition">
                        <span class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center shrink-0">
                            <i data-lucide="list-tree" class="w-4 h-4"></i>
                        </span>
                        <span class="min-w-0">
                            <span class="text-xs font-medium block text-gray-200">Menu de opções</span>
                            <span class="text-[10px] text-gray-500 block">Pergunta e ramifica</span>
                        </span>
                    </button>
                </div>
            </div>

            <div class="border-t border-white/5 pt-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-gray-600 px-1 mb-2">Legenda</p>
                <ul class="space-y-2 text-[11px] text-gray-500 px-1">
                    <li class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Bloco de início</li>
                    <li class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span> Caminho automático</li>
                    <li class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span> Caminho por opção</li>
                    <li class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span> Fim da conversa</li>
                </ul>
            </div>

            <div class="border-t border-white/5 pt-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-gray-600 px-1 mb-2">Atalhos</p>
                <ul class="space-y-1.5 text-[11px] text-gray-500 px-1 leading-relaxed">
                    <li>Arraste o fundo para mover o mapa</li>
                    <li>Ctrl + rolagem para dar zoom</li>
                    <li>Clique na bolinha de saída e depois em outro bloco para ligar</li>
                    <li><kbd class="px-1 py-0.5 bg-white/5 rounded border border-white/10">Esc</kbd> cancela a ligação</li>
                </ul>
            </div>
        </aside>

        <!-- ======================= CANVAS ======================= -->
        <main id="canvas" class="flex-1 canvas-grid relative overflow-hidden cursor-grab">
            <div id="mundo" class="absolute top-0 left-0 origin-top-left" style="width: 6000px; height: 4000px;">
                <svg id="conexoes" width="6000" height="4000" class="absolute top-0 left-0 pointer-events-none">
                    <defs>
                        <marker id="seta-azul" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#38bdf8"></path>
                        </marker>
                        <marker id="seta-ambar" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M 0 0 L 10 5 L 0 10 z" fill="#fbbf24"></path>
                        </marker>
                    </defs>
                </svg>
                <div id="nos"></div>
            </div>

            <!-- estado vazio -->
            <div id="canvasVazio" class="absolute inset-0 flex items-center justify-center pointer-events-none hidden">
                <div class="text-center">
                    <p class="text-sm text-gray-500">Este fluxo está vazio.</p>
                    <p class="text-xs text-gray-600 mt-1">Use "Adicionar bloco" à esquerda para começar.</p>
                </div>
            </div>

            <!-- aviso do modo ligação -->
            <div id="avisoLigacao" class="hidden absolute top-4 left-1/2 -translate-x-1/2 bg-amber-500/15 border border-amber-500/30 text-amber-200 text-xs px-4 py-2 rounded-lg shadow-lg">
                Clique no bloco de destino · <kbd class="px-1 bg-black/30 rounded">Esc</kbd> para cancelar
            </div>

            <!-- controles de zoom -->
            <div class="absolute bottom-4 left-4 flex items-center gap-1 bg-[#161a22] border border-white/10 rounded-lg p-1 shadow-lg">
                <button type="button" id="btnZoomOut" class="w-7 h-7 rounded-md hover:bg-white/5 text-gray-400 flex items-center justify-center transition"><i data-lucide="minus" class="w-3.5 h-3.5"></i></button>
                <span id="lblZoom" class="text-[11px] text-gray-500 w-10 text-center">100%</span>
                <button type="button" id="btnZoomIn" class="w-7 h-7 rounded-md hover:bg-white/5 text-gray-400 flex items-center justify-center transition"><i data-lucide="plus" class="w-3.5 h-3.5"></i></button>
                <span class="w-px h-4 bg-white/10 mx-0.5"></span>
                <button type="button" id="btnCentralizar" class="w-7 h-7 rounded-md hover:bg-white/5 text-gray-400 flex items-center justify-center transition" title="Centralizar no início"><i data-lucide="crosshair" class="w-3.5 h-3.5"></i></button>
            </div>
        </main>

        <!-- ======================= EDITOR ======================= -->
        <aside id="editor" class="w-80 shrink-0 border-l border-white/5 bg-[#11141a] flex flex-col overflow-hidden">
            <div id="editorVazio" class="flex-1 flex items-center justify-center p-6 text-center">
                <div>
                    <span class="inline-flex w-12 h-12 rounded-xl bg-white/5 text-gray-600 items-center justify-center mb-3">
                        <i data-lucide="mouse-pointer-click" class="w-5 h-5"></i>
                    </span>
                    <p class="text-xs text-gray-500 leading-relaxed">Clique em um bloco do mapa<br />para editar o que o bot diz.</p>
                </div>
            </div>

            <div id="editorConteudo" class="hidden flex-1 flex flex-col min-h-0">
                <div class="h-12 shrink-0 px-4 flex items-center justify-between border-b border-white/5">
                    <div class="flex items-center gap-2 min-w-0">
                        <span id="editorTipoIcone" class="w-6 h-6 rounded-md bg-sky-500/10 text-sky-400 flex items-center justify-center shrink-0">
                            <i data-lucide="message-square" class="w-3.5 h-3.5"></i>
                        </span>
                        <span id="editorTipo" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 truncate">Mensagem</span>
                    </div>
                    <button type="button" id="btnFecharEditor" class="text-gray-600 hover:text-gray-300 transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-5">

                    <div>
                        <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600 block mb-1.5">Nome do bloco</label>
                        <input type="text" id="campoTitulo" maxlength="60" placeholder="Ex: Boas-vindas"
                               class="w-full bg-[#161a22] border border-white/10 rounded-lg px-3 py-2 text-xs text-gray-200 placeholder-gray-600 focus:outline-none focus:border-emerald-500/50" />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600">Mensagem enviada</label>
                            <span class="text-[10px] text-gray-600">*negrito* _itálico_</span>
                        </div>
                        <textarea id="campoConteudo" rows="6" placeholder="Digite o texto que o bot vai enviar..."
                                  class="w-full bg-[#161a22] border border-white/10 rounded-lg p-3 text-xs text-gray-200 placeholder-gray-600 focus:outline-none focus:border-emerald-500/50 resize-none leading-relaxed"></textarea>
                        <div class="flex items-center justify-between mt-1.5">
                            <span class="text-[10px] text-gray-600">Salva ao sair do campo</span>
                            <button type="button" id="btnSalvarTexto" class="text-[11px] font-semibold text-emerald-400 hover:text-emerald-300 transition">Salvar agora</button>
                        </div>
                    </div>

                    <div id="blocoSequencial">
                        <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600 block mb-1.5">Depois desta mensagem</label>
                        <select id="campoProximo" class="w-full bg-[#161a22] border border-white/10 rounded-lg px-3 py-2 text-xs text-gray-200 focus:outline-none focus:border-emerald-500/50">
                        </select>
                        <p class="text-[10px] text-gray-600 mt-1.5 leading-relaxed">
                            Encerrar significa que a conversa termina aqui. Com um bloco escolhido, o bot envia as duas mensagens seguidas.
                        </p>
                    </div>

                    <div class="border-t border-white/5 pt-4">
                        <div class="flex items-center justify-between mb-2">
                            <label class="text-[10px] font-bold uppercase tracking-widest text-gray-600">Opções de resposta</label>
                            <span id="contadorOpcoes" class="text-[10px] text-gray-600"></span>
                        </div>

                        <div id="listaOpcoes" class="space-y-2"></div>

                        <div class="mt-3 bg-[#161a22] border border-white/5 rounded-xl p-3 space-y-2">
                            <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-400">Nova opção</p>
                            <input type="text" id="novaOpcaoChave" maxlength="40" placeholder="O que o cliente digita (ex: 1, sim, suporte)"
                                   class="w-full bg-[#0f1218] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-gray-200 placeholder-gray-600 focus:outline-none focus:border-emerald-500/50" />
                            <select id="novaOpcaoDestino" class="w-full bg-[#0f1218] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-gray-200 focus:outline-none focus:border-emerald-500/50"></select>
                            <button type="button" id="btnAdicionarOpcao" class="w-full py-1.5 bg-emerald-500 hover:bg-emerald-400 text-[#0d0f13] rounded-lg text-xs font-semibold transition">
                                Adicionar caminho
                            </button>
                        </div>
                    </div>
                </div>

                <div class="shrink-0 border-t border-white/5 p-3 flex items-center gap-2">
                    <button type="button" id="btnDefinirInicio" class="flex-1 inline-flex items-center justify-center gap-1.5 text-[11px] font-semibold px-3 py-2 rounded-lg border border-white/10 hover:bg-white/5 text-gray-300 transition">
                        <i data-lucide="flag" class="w-3.5 h-3.5"></i> Marcar como início
                    </button>
                    <button type="button" id="btnExcluirNo" class="inline-flex items-center justify-center p-2 rounded-lg border border-white/10 text-gray-500 hover:text-rose-400 hover:border-rose-500/30 transition" title="Excluir bloco">
                        <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                    </button>
                </div>
            </div>
        </aside>
    </div>

    <div id="toasts" class="fixed bottom-6 right-6 z-50 space-y-2"></div>

    <script>window.__fluxo = @Html.Raw(fluxoJson);</script>
    <script src="~/js/app.js" asp-append-version="true"></script>
    <script src="~/js/builder.js" asp-append-version="true"></script>
</body>
</html>
